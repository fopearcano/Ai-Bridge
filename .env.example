# Copy to .env and fill in. Never commit .env.

# ---- LLM providers -------------------------------------------------------
# Comma-separated list of providers Ai-Bridge is allowed to use.
# Allowed values: openai, anthropic, lmstudio
PROVIDERS=openai,anthropic,lmstudio

# Which provider is used by default. Must be one of PROVIDERS.
# Allowed: openai | anthropic | lmstudio
DEFAULT_PROVIDER=anthropic

# OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# LM Studio (local OpenAI-compatible server) -------------------------------
# Base URL of your LM Studio server (must include the /v1 suffix).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Model identifier as shown in LM Studio (required when DEFAULT_PROVIDER=lmstudio).
LMSTUDIO_MODEL=
# LM Studio ignores the value but the OpenAI client requires a non-empty key.
LMSTUDIO_API_KEY=lm-studio

# ---- Bridge mode ---------------------------------------------------------
# dev    -> verbose, no scene side effects
# safe   -> require user confirmation before executing generated code
# direct -> execute generated code immediately (use with care)
MODE=safe

# ---- Houdini transport ---------------------------------------------------
# Host/port the bridge will reach Houdini on (RPC server inside Houdini).
HOUDINI_HOST=127.0.0.1
HOUDINI_PORT=18861

# Absolute path to Houdini's `hython` binary (used for headless execution).
# Examples:
#   /opt/hfs20.5/bin/hython
#   C:\Program Files\Side Effects Software\Houdini 20.5\bin\hython.exe
HYTHON_PATH=

# ---- Logging -------------------------------------------------------------
# Allowed: DEBUG | INFO | WARNING | ERROR | CRITICAL
AIBRIDGE_LOG_LEVEL=INFO
AIBRIDGE_LOG_DIR=logs
